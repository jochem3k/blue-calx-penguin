variant: fcos
version: 1.5.0
passwd:
  groups:
    - name: docker
  users:
    - name: docker-prod
      groups:
        - wheel
        - docker
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIL+2ziXZaHbOE3RHbvmxpQtqgWaKVKzAW1ay/nQcaUSi jochem@desktop-jochem
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIH9S2P443VA/RLVZojYRGnRD49fV4jyxsbf8rX1I4Qen jochem@thinkpad-jochem
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICDXG3kPJo+9zVti0TctqjNPrbXLbZrsTMqGYgE21hkL n8n
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJCLrjQHqsgwHawlZ6o27uvOdOiopO+GB3+EAAaeUx4l conduit

storage:
  directories:
    - path: /var/opt/docker
      mode: 0755
      user:
        name: docker-prod
      group:
        name: docker-prod

  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: docker-prod

    - path: /etc/NetworkManager/system-connections/ens18.nmconnection
      mode: 0600
      contents:
        inline: |
          [connection]
          id=ens18
          type=ethernet
          interface-name=ens18

          [ipv4]
          method=manual
          address1=192.168.2.251/24
          gateway=192.168.2.254
          dns=192.168.2.254;

          [ipv6]
          method=disabled

    - path: /etc/sudoers.d/docker-prod-passwordless
      mode: 0440
      contents:
        inline: |
          docker-prod ALL=(ALL) NOPASSWD: ALL

systemd:
  units:
    - name: var-lib-docker.mount
      enabled: true
      contents: |
        [Unit]
        Description=Mount Dedicated Storage for Docker Data
        Before=docker.service podman.service

        [Mount]
        What=/dev/disk/by-label/Docker
        Where=/var/lib/docker
        Type=xfs
        Options=defaults,noatime,pquota,nofail

        [Install]
        WantedBy=local-fs.target
