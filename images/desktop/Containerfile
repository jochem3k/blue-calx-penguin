# Set Fedora version
ARG FEDORA_VERSION=45

# Allow build scripts to be referenced without being copied into the final image
FROM scratch AS ctx
COPY images/common/build_files /common/build_files
COPY images/common/system_files /common/system_files
COPY images/desktop/build_files /build_files
COPY images/desktop/system_files /system_files
COPY images/gnome/build_files /gnome/build_files
COPY images/gnome/system_files /gnome/system_files


# Base Image
FROM ghcr.io/ublue-os/akmods-nvidia-open:main-${FEDORA_VERSION} AS nvidia-akmods
FROM ghcr.io/ublue-os/silverblue-main:${FEDORA_VERSION}

### [IM]MUTABLE /opt
## Some bootable images, like Fedora, have /opt symlinked to /var/opt, in order to
## make it mutable/writable for users. However, some packages write files to this directory,
## thus its contents might be wiped out when bootc deploys an image, making it troublesome for
## some packages. Eg, google-chrome, docker-desktop.
##
## Uncomment the following line if one desires to make /opt immutable and be able to be used
## by the package manager.

# RUN rm /opt && mkdir /opt

### MODIFICATIONS
## The ctx stage puts shared files at /ctx/common/ and this machine's files at /ctx/.
## /ctx/build_files/build.sh sources the common script, then applies desktop-specific tweaks.
## Bluebuild Gnome extension module is mounted, default sequence commented out below.
## Nvidia AKMODS mounted

RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=bind,from=ghcr.io/blue-build/modules:latest,src=/modules,dst=/tmp/modules,rw \
    --mount=type=bind,from=ghcr.io/blue-build/cli/build-scripts:latest,src=/scripts/,dst=/tmp/scripts/ \
    --mount=type=bind,from=nvidia-akmods,source=/rpms,target=/tmp/akmods-rpms \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/build_files/build.sh

#    RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
#        --mount=type=cache,dst=/var/cache \
#        --mount=type=cache,dst=/var/log \
#        --mount=type=tmpfs,dst=/tmp \
#        /ctx/build_files/build.sh

### LINTING
## Verify final image and contents are correct.
RUN bootc container lint
